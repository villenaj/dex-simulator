# Joins the network created by ../docker-compose.infra.yml so "mongo" / "mariadb" resolve.
# Start the infra stack first: docker compose -f ../docker-compose.infra.yml up -d
services:
  simulator:
    build: .
    image: xodex-simulator:local
    container_name: xodex-simulator
    restart: unless-stopped
    user: "1000:1000"
    command: ["live"]
    env_file: .env
    environment:
      MONGO_URI: mongo
      MARIA_DB_HOST: mariadb
      # 시간대별 활동 가중치와 MariaDB created_at 이 호스트와 같은 기준이 되도록 맞춥니다.
      TZ: ${TZ:-Asia/Manila}
    volumes:
      - ./state:/app/state
    networks:
      - infra

networks:
  infra:
    external: true
    name: rakson-opc-dex_default
