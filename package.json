{
  "name": "net.xode.simulator",
  "version": "1.0.0",
  "description": "XON/USDT swap activity simulator that submits real swaps on the Xode dev chain",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "live": "tsx src/index.ts live",
    "fund": "tsx src/index.ts fund",
    "status": "tsx src/index.ts status",
    "purge": "tsx src/index.ts purge",
    "build": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@polkadot/api": "^16.5.6",
    "@polkadot/api-augment": "^16.5.6",
    "dotenv": "^17.3.1",
    "mariadb": "^3.5.2",
    "mongodb": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
