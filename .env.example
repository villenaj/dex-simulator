# Xode dev chain (Local Testnet, para 5160). The simulator signs and submits real swaps here,
# and the queue indexes them into Mongo / MariaDB like any other user's swaps.
SIM_RPC_URL=ws://192.168.254.200:9977
# Refuses to sign anything unless system.chain() returns exactly this name.
SIM_EXPECTED_CHAIN=Local Testnet
# Funds the simulator wallets with XON and USDT (dev chain //Alice holds both).
SIM_FUNDER_SURI=//Alice
# Wallet i is `${SIM_WALLET_SURI}//i`. Public dev keys: never use them on mainnet.
SIM_WALLET_SURI=//XodeSim
SIM_QUOTE_ASSET_ID=1984
SIM_SLIPPAGE_BPS=100
# Wallets below half of these are topped back up to them.
SIM_FUND_XON=200
SIM_FUND_USDT=1000

# Pair to simulate
SIM_POOL_ID=0
SIM_BASE=XON
SIM_QUOTE=USDT

# Activity
SIM_TRADES_PER_DAY=18
SIM_WALLET_COUNT=24

# Price behaviour: wallets lean towards a "fair price" that random-walks at this daily volatility.
# The fill price itself always comes from the pool.
SIM_DAILY_VOLATILITY=0.06
# Median trade size in USDT (log-normal)
SIM_MEDIAN_TRADE_USDT=35

# Optional fixed RNG seed for reproducible runs (blank = random)
SIM_SEED=

# Only used by `purge`, which removes the fake rows older versions wrote straight into the DBs.
# Only localhost hosts are accepted.
MONGO_URI=127.0.0.1
MONGO_PORT=27017
MONGO_DB_NAME=xode_indexer
MONGO_USER=dex
MONGO_PASS=devpass
MONGO_AUTH_SOURCE=admin

MARIA_DB_HOST=127.0.0.1
MARIA_DB_PORT=3306
MARIA_DB_USER=root
MARIA_DB_PASS=devpass
MARIA_DB_NAME=dex_db
